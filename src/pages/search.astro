---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" currentPath="/search">
  <div style="max-width: 720px; margin: 0 auto; padding: 3rem clamp(1.5rem, 5vw, 5rem) 4rem;">
    <div class="article-eyebrow">Search</div>
    <h1 class="article-title" style="margin-bottom: 2rem;">Find Articles</h1>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
  </div>

  <style is:global>
    :root {
      --pagefind-ui-scale: 0.9;
      --pagefind-ui-primary: var(--accent, #a5481b);
      --pagefind-ui-text: var(--ink, #1c1813);
      --pagefind-ui-background: var(--paper, #e9e4da);
      --pagefind-ui-border: var(--paper-rule, #d3ccbf);
      --pagefind-ui-tag: var(--paper-warm, #e0dacd);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 0;
      --pagefind-ui-font: var(--font-body, 'Cormorant Garamond', serif);
    }

    .pagefind-ui__search-input {
      font-family: var(--font-body, 'Cormorant Garamond', serif) !important;
    }

    .pagefind-ui__result-title {
      font-family: var(--font-display, 'Cormorant Garamond', sans-serif) !important;
      font-weight: 600 !important;
    }

    .pagefind-ui__result-link {
      color: var(--ink, #1c1813) !important;
    }

    .pagefind-ui__result-link:hover {
      color: var(--accent, #a5481b) !important;
    }

    .pagefind-ui__result-excerpt {
      font-size: 0.9rem !important;
      color: var(--ink-mid, #5a5142) !important;
      line-height: 1.7 !important;
    }
  </style>

  <script is:inline>
    (function() {
      var script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = function() {
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
        });
      };
      document.head.appendChild(script);
    })();
  </script>
</BaseLayout>
